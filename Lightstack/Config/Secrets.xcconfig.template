// Lightstack — API Key Configuration
// Copy this file to Secrets.xcconfig and fill in your keys.
// Secrets.xcconfig is git-ignored — NEVER commit it.

GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

// Google Sign-In — iOS OAuth client ID from Google Cloud Console.
// Format: NNNNNN-xxxxx.apps.googleusercontent.com
// Create it at https://console.cloud.google.com → APIs & Services → Credentials
// → Create Credentials → OAuth 2.0 Client ID → Application type: iOS
GOOGLE_CLIENT_ID=

// Reversed iOS OAuth client ID — same value as GOOGLE_CLIENT_ID but reversed.
// e.g. if GOOGLE_CLIENT_ID=com.googleusercontent.apps.NNNNNN-xxxxx
//      then GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.NNNNNN-xxxxx
// More precisely: reverse the domain components, e.g.
//   GOOGLE_CLIENT_ID=123456-abc.apps.googleusercontent.com
//   GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.123456-abc
GOOGLE_REVERSED_CLIENT_ID=
